# App
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="auth_session"
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# PostgreSQL (matches compose.yaml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_starter?schema=public"

# Optional SMTP. In development, if these are empty, email links are printed to the terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Auth Starter <no-reply@example.com>"

# Optional admin seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-production"
ADMIN_NAME="Admin"
